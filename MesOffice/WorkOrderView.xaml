<UserControl x:Class="MesOffice.WorkOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MesOffice"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- 제목 -->
            <RowDefinition Height="Auto"/><!-- 조회 조건 -->
            <RowDefinition Height="*"/><!-- 그리드 -->
            <RowDefinition Height="Auto"/><!-- 상태 표시줄 -->
            <RowDefinition Height="Auto"/><!-- 신규 등록 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="작업지시" FontSize="18" Margin="0,0,0,12"/>
        
        <!-- 조회 조건-->
        <Border Grid.Row="1" Background="#F5F6F8" Padding="12" CornerRadius="4" Margin="0, 0, 0, 10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="생산일" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                <TextBlock Text="~" Style="{StaticResource FieldLabel}" Margin="8,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>

                <TextBlock Text="상태" Style="{StaticResource FieldLabel}" Margin="20,0,6,0"/>
                <ComboBox Width="100"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter}"/>

                <Button Content="조회" Command="{Binding SearchCommand}"
                        Style="{StaticResource ActionButton}" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 결과 그리드 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="26"
                  AlternatingRowBackground="#FAFAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="지시번호"  Binding="{Binding WoNo}"      Width="130"/>
                <DataGridTextColumn Header="생산일"    Binding="{Binding PlanDate, StringFormat=yyyy-MM-dd}" Width="95"/>
                <DataGridTextColumn Header="품목"      Binding="{Binding ItemName}"  Width="*"/>
                <DataGridTextColumn Header="설비"      Binding="{Binding EquipName}" Width="110"/>
                <DataGridTextColumn Header="지시수량"  Binding="{Binding OrderQty,  StringFormat=N0}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="생산수량"  Binding="{Binding ProdQty,   StringFormat=N0}" Width="85"/>
                <DataGridTextColumn Header="잔량"      Binding="{Binding RemainQty, StringFormat=N0}" Width="85"/>
                <DataGridTextColumn Header="필요타수"  Binding="{Binding ShotNeeded, StringFormat=N0}" Width="85"/>
                <DataGridTextColumn Header="상태"      Binding="{Binding StatusName}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}"
                   Foreground="#666" Margin="2,6,0,10"/>

        <!-- 신규 등록 -->
        <GroupBox Grid.Row="4" Header="신규 등록" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="지시번호" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding WoNo}" Width="130" IsReadOnly="True"
                         Background="#F0F0F0" VerticalContentAlignment="Center"/>

                <TextBlock Text="품목" Style="{StaticResource FieldLabel}" Margin="16,0,6,0"/>
                <ComboBox Width="200"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"/>

                <TextBlock Text="설비" Style="{StaticResource FieldLabel}" Margin="16,0,6,0"/>
                <ComboBox Width="130"
                          ItemsSource="{Binding Equips}"
                          SelectedItem="{Binding SelectedEquip}"/>

                <TextBlock Text="생산일" Style="{StaticResource FieldLabel}" Margin="16,0,6,0"/>
                <DatePicker SelectedDate="{Binding PlanDate}" Width="120"/>

                <TextBlock Text="수량" Style="{StaticResource FieldLabel}" Margin="16,0,6,0"/>
                <TextBox Width="90" VerticalContentAlignment="Center"
                         TextAlignment="Right"
                         Text="{Binding OrderQty, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="저장" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButton}" Margin="20,0,0,0"/>
                <Button Content="초기화" Command="{Binding ResetCommand}"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
